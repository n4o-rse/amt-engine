# Generated from deploy/redirects.yaml by py/site_redirects.py. Do not edit.
RewriteEngine On
RewriteBase /ids/amt/

RewriteRule ^$ https://n4o-rse.github.io/amt-engine/ [R=302,L]

# The vocabulary: content negotiation on the Accept header
RewriteCond %{HTTP_ACCEPT} text/turtle|application/x-turtle
RewriteRule ^vocab/?$ https://n4o-rse.github.io/amt-engine/vocab/amt.ttl [R=302,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^vocab/?$ https://n4o-rse.github.io/amt-engine/vocab/amt.rdf [R=302,L]
RewriteCond %{HTTP_ACCEPT} application/(ld\+)?json
RewriteRule ^vocab/?$ https://n4o-rse.github.io/amt-engine/vocab/amt.jsonld [R=302,L]
RewriteRule ^vocab/?$ https://n4o-rse.github.io/amt-engine/vocab/ [R=302,L]

RewriteRule ^explorer/?$ https://n4o-rse.github.io/amt-engine/explorer/ [R=302,L]

RewriteRule ^ontology/?$ https://n4o-rse.github.io/amt-engine/ontology/ [R=302,L]

RewriteRule ^engine/?$ https://github.com/n4o-rse/amt-engine [R=302,L]

RewriteRule ^runner/?$ https://github.com/n4o-rse/amt-runner [R=302,L]

RewriteRule ^doi/?$ https://doi.org/10.5281/zenodo.23669466 [R=302,L]
