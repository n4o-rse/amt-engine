# Generated from deploy/redirects.yaml by py/site_redirects.py. Do not edit.
RewriteEngine On

RewriteRule ^$ https://alpaca-fair-framework.github.io/amt-engine/ [R=302,L]

# The vocabulary: content negotiation on the Accept header
RewriteCond %{HTTP_ACCEPT} text/turtle|application/x-turtle
RewriteRule ^vocab/?$ https://alpaca-fair-framework.github.io/amt-engine/vocab/amt.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^vocab/?$ https://alpaca-fair-framework.github.io/amt-engine/vocab/amt.rdf [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/(ld\+)?json
RewriteRule ^vocab/?$ https://alpaca-fair-framework.github.io/amt-engine/vocab/amt.jsonld [R=303,L]
RewriteRule ^vocab/?$ https://alpaca-fair-framework.github.io/amt-engine/vocab/ [R=303,L]

RewriteRule ^explorer/?$ https://alpaca-fair-framework.github.io/amt-engine/explorer/ [R=302,L]

RewriteRule ^ontology/?$ https://alpaca-fair-framework.github.io/amt-engine/ontology/ [R=302,L]

RewriteRule ^amt\.rdf/?$ https://alpaca-fair-framework.github.io/amt-engine/vocab/amt.rdf [R=301,L]
